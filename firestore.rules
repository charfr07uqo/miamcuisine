rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        (request.auth.token.email == 'francois.c.n@gmail.com' ||
         request.auth.token.email == 'karine.glandon@gmail.com');
    }

    match /ingredients/{ingredientId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /recettes/{recetteId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null &&
        (request.auth.uid == resource.data.authorId || isAdmin());
    }

    match /recetteIngredients/{docId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null &&
        (request.auth.uid == userId || isAdmin());
    }

    match /userRecettes/{docId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null &&
        (request.auth.uid == resource.data.userId || isAdmin());
    }
  }
}
